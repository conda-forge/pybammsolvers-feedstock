Build against the conda-forge CasADi (a host dependency) instead of the
CasADi pip wheel that upstream defaults to on Linux/macOS. Adds conda as
a case alongside the existing Windows/vcpkg one, keyed off CONDA_BUILD
like the vcpkg check at the top of the file.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -126,7 +126,9 @@ pybind11_add_module(idaklu
 
 if (NOT DEFINED USE_PYTHON_CASADI)
     # Windows uses vcpkg for CasADi (no pip wheel exists); Linux/macOS use pip.
-    if (WIN32)
+    # Under conda (CONDA_BUILD=1) CasADi is a host dependency on every platform,
+    # so use that build rather than one from a pip site-packages tree.
+    if (WIN32 OR DEFINED ENV{CONDA_BUILD})
         set(USE_PYTHON_CASADI FALSE)
     else()
         set(USE_PYTHON_CASADI TRUE)
